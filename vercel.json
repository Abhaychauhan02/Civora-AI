{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(css|js|uploads)/(.*)",
      "destination": "/frontend/$1/$2"
    },
    {
      "source": "/(manifest.json|sw.js|favicon.ico)",
      "destination": "/frontend/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/index.html"
    }
  ]
}
