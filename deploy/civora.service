[Unit]
Description=Civora AI - Municipal Civic Intelligence and Resolution Platform
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Civora-AI
ExecStart=/home/ubuntu/Civora-AI/venv/bin/python main.py
Restart=always
RestartSec=3
Environment=PYTHONPATH=/home/ubuntu/Civora-AI
Environment=TRANSFORMERS_OFFLINE=1
Environment=HF_HUB_OFFLINE=1
Environment=HOST=127.0.0.1
Environment=PORT=8000

# Security & limits
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
